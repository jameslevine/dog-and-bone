# Stripe — publishable key (safe to expose in frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe — secret key (server-side only, never expose in frontend)
STRIPE_SECRET_KEY=sk_test_...

# Stripe — webhook signing secret (from Stripe Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — one per product (create in Stripe Dashboard → Products)
STRIPE_PRICE_ESSENTIAL=price_...
STRIPE_PRICE_FAMILY=price_...
STRIPE_PRICE_SENIOR=price_...
STRIPE_PRICE_BALANCE=price_...
STRIPE_PRICE_CHARGER=price_...
STRIPE_PRICE_EXPRESS=price_...

# Rewardful — affiliate programme tracking ID (optional)
VITE_REWARDFUL_ID=your_rewardful_id

# Admin — secret token to access the generate-setup-script function
ADMIN_SECRET=change_me_to_a_long_random_string

# AWS (uses default profile from ~/.aws/credentials — no env vars needed for local dev)
# AWS_REGION=eu-west-2
